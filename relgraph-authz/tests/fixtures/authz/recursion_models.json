    {
      "id": "difference-through-tuple-to-userset-cycle",
      "definition": "model\n  schema 1.1\n\ntype user\n\ntype folder\n  relations\n    define parent: [folder]\n    define blocked: [user] or viewer from parent\n    define viewer: [user] but not blocked\n",
      "model": {
        "schema_version": "1.1",
        "type_definitions": [
          {
            "type": "user"
          },
          {
            "metadata": {
              "relations": {
                "blocked": {
                  "directly_related_user_types": [
                    {
                      "type": "user"
                    }
                  ]
                },
                "parent": {
                  "directly_related_user_types": [
                    {
                      "type": "folder"
                    }
                  ]
                },
                "viewer": {
                  "directly_related_user_types": [
                    {
                      "type": "user"
                    }
                  ]
                }
              }
            },
            "relations": {
              "blocked": {
                "union": {
                  "child": [
                    {
                      "this": {}
                    },
                    {
                      "tupleToUserset": {
                        "computedUserset": {
                          "relation": "viewer"
                        },
                        "tupleset": {
                          "relation": "parent"
                        }
                      }
                    }
                  ]
                }
              },
              "parent": {
                "this": {}
              },
              "viewer": {
                "difference": {
                  "base": {
                    "this": {}
                  },
                  "subtract": {
                    "computedUserset": {
                      "relation": "blocked"
                    }
                  }
                }
              }
            },
            "type": "folder"
          }
        ]
      },
      "expected": {
        "server_model": "accepted"
      },
      "local_capabilities": [
        "RecursiveDifference"
      ],
      "tuples": [
