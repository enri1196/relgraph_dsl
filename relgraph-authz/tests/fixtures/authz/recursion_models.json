          "object": "folder:c"
        },
        {
          "user": "user:anne",
          "relation": "viewer",
          "object": "folder:c"
        },
        {
          "user": "folder:x",
          "relation": "parent",
          "object": "folder:x"
        },
        {
          "user": "user:anne",
          "relation": "viewer",
          "object": "folder:x"
        }
      ],
      "cases": [
