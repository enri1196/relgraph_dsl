model
  schema 1.1

type user

type group
  relations
    define member: [user]

type folder
  relations
    define viewer: [user]

type document
  relations
    define owner: [user]
    define editor: [user] or owner
    define direct_viewer: [user]
    define group_viewer: [group#member]
    define public_viewer: [user:*]
    define parent: [folder]
    define viewer: [user] or editor or viewer from parent
    define all_viewer: group_viewer and direct_viewer
    define blocked: [user]
    define visible: [user] but not blocked
